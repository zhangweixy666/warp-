# 本仓库为 Shell 部署脚本 + Go 源码包，不使用 C/C++ 构建产物忽略规则。

# ---- 备份与临时文件（脚本运行时会产生 .orig / .system / .bak / .tmp）----
*.orig
*.system
*.bak
*.tmp
*.swp
*~

# ---- 日志与测试产物 ----
*.log
nohup.out
/test-work/
/tests/output/

# ---- 下载/构建产物：warp 二进制由 GitHub Release 分发，不入库 ----
# 见 README「安装」章节；脚本会从 Release 下载，仓库内不再携带副本。
/warp
/warp-go
shadowquic
shadowquic-*

# ---- Go 构建产物（源码以 tar.gz 形式归档，若日后直接入库则有用）----
*.exe
*.test
*.out
/vendor/

# ---- 编辑器与系统 ----
.idea/
.vscode/
.DS_Store
